<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Screen Title -->
    <TextView
        android:id="@+id/txtCloudTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cloud_title"
        android:textColor="@color/my_custom_color"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- User ID -->
    <EditText
        android:id="@+id/editUserId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_user_id"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/txtCloudTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Name -->
    <EditText
        android:id="@+id/editName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_name"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/editUserId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Role -->
    <EditText
        android:id="@+id/editRole"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_role"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/editName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Email -->
    <EditText
        android:id="@+id/editEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/editRole"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Three Buttons in One Row -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/editEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSaveUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/save_user"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnUpdateRole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/update_role"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDeleteUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/delete_user"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Cloud Data Display -->
    <TextView
        android:id="@+id/txtCloudData"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/no_users"
        android:textSize="16sp"
        android:padding="8dp"
        android:gravity="top"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/buttonRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
